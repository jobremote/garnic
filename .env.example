# Copie para .env.local (que não vai para o Git) e ajuste. Nenhuma senha, chave ou token entra no repositório.

# Segredo da aplicação: assina cookies e protege os códigos de validação.
# Obrigatório em produção e homologação (texto aleatório de 32 caracteres ou mais).
# Em desenvolvimento local, se ficar vazio, usa um valor fixo e inseguro, só para rodar.
AUTH_SECRET=

# Banco Neon (um por ambiente). Em desenvolvimento local, deixe vazio:
# o Garnic usa o Postgres embutido (PGlite) em .data/pglite.
DATABASE_URL=

# E-mail. Enquanto o Resend não está ligado, "dev" grava os e-mails na caixa de saída de desenvolvimento
# (/dev/emails) em vez de enviar. Fora de produção isso já é o padrão.
EMAIL_PROVIDER=

# Endereço público do app, usado nos links dos e-mails (recuperar senha). Obrigatório em produção e homologação.
# Em desenvolvimento, vazio vale http://localhost:3000.
APP_URL=
