# Copie para .env.local (que não vai para o Git) e ajuste. Nenhuma senha, chave ou token entra no repositório.

# Segredo da aplicação: assina cookies e protege os códigos de validação.
# Obrigatório em produção e homologação (texto aleatório de 32 caracteres ou mais).
# Em desenvolvimento local, se ficar vazio, usa um valor fixo e inseguro, só para rodar.
AUTH_SECRET=

# Banco Neon (um por ambiente). Em desenvolvimento local, deixe vazio:
# o Garnic usa o Postgres embutido (PGlite) em .data/pglite.
DATABASE_URL=

# E-mail. Enquanto o Resend não está ligado, "dev" grava os e-mails na caixa de saída de desenvolvimento
# (/dev/emails) em vez de enviar. Fora de produção isso já é o padrão.
EMAIL_PROVIDER=

# Endereço público do app, usado nos links dos e-mails (recuperar senha). Obrigatório em produção e homologação.
# Em desenvolvimento, vazio vale http://localhost:3000.
APP_URL=

# Login com Google (OAuth). Crie um "ID do cliente OAuth" (aplicativo da Web) no Google Cloud e cadastre o endereço
# de retorno {APP_URL}/api/auth/google/callback. Sem estas duas variáveis, em desenvolvimento o Garnic usa um
# Google simulado (/dev/google); em produção o botão do Google leva a uma tela de erro.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Imagens de avatar e capa (Vercel Blob, store PÚBLICO). Crie o store no painel da Vercel e ligue-o ao projeto: a Vercel
# cria sozinha, nos ambientes ligados, BLOB_STORE_ID (autenticação por OIDC, sem token fixo) e BLOB_WEBHOOK_PUBLIC_KEY.
# Em desenvolvimento local, deixe tudo vazio: as imagens vão para .data/uploads.
# Em produção e homologação sem o Blob, o envio de imagem fica desabilitado.
# BLOB_READ_WRITE_TOKEN só existe em stores antigos ou se você pedir o token na criação; o código aceita os dois jeitos.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# IGDB (busca de jogos da Game Shelf). Crie um aplicativo no Twitch Developer Portal (Client Type: Confidential, OAuth
# Redirect URL: https://localhost) e gere um Client Secret. Estes valores ficam só no servidor: nunca em NEXT_PUBLIC_*,
# nunca no Git. Sem eles, a busca de jogos mostra que o IGDB não está configurado neste ambiente.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
